{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "command": {
    "developer": {
      "description": "Switch to Developer agent (implementation)",
      "template": "Switch to developer mode",
      "agent": "developer"
    },
    "debugger": {
      "description": "Switch to Debugger agent (error triage)",
      "template": "Switch to debugger mode",
      "agent": "debugger"
    },
    "planning": {
      "description": "Switch to Planning agent (architecture/PM)",
      "template": "Switch to planning mode",
      "agent": "planning"
    },
    "study": {
      "description": "Switch to Study agent (read-only education)",
      "template": "Switch to study mode",
      "agent": "study"
    },
    "suggestion": {
      "description": "Switch to Suggestion agent (read-only optimization)",
      "template": "Switch to suggestion mode",
      "agent": "suggestion"
    }
  }
}
